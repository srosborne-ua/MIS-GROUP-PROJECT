# Copy to .env (git-ignored) and fill in. Never commit real values.
# On Azure these are App Service environment variables instead.

# Druid AI Assistant (Anthropic API)
ANTHROPIC_API_KEY=sk-ant-...
# CONCIERGE_MODEL=claude-opus-5-5

# Database: the API's read/write login (SELECT, INSERT, UPDATE, DELETE on mis321)
DB_APP_CONNECTION="Server=your-server;Database=mis321;User ID=druid_app;Password=...;SslMode=Required;"

# Concierge knowledge base (optional): read-only login, SELECT on v_knowledge_documents only.
# Leave unset to have the concierge answer from hotel-info.json instead.
DB_LLM_RO_CONNECTION="Server=your-server;Database=mis321;User ID=druid_llm_ro;Password=...;SslMode=Required;"

# Admin login for running schema/seed/migrate scripts by hand (never used by the API)
# DB_ADMIN_USER=...
# DB_ADMIN_PASSWORD=...

# Live site only: lets "Reset sample data" run. Set, reset once, then remove.
# ALLOW_SAMPLE_RESET=true
